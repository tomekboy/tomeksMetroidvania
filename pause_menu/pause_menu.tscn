[sub_resource type="GDScript" id="GDScript_0v28v"]
script/source = "extends Control

@onready var pause_portal_01: Node2D = $MapDisplay/Portals/PausePortal01

# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if SceneManager.current_scene.contains(\"01_cavernland\"):
		pause_portal_01.visible = true
	pass
"

